# ŞartMercek — Örnek Ortam Değişkenleri
# NOT: API anahtarınızı kaynak koduna veya Git'e ASLA eklemeyiniz.
# Bu değişkenler yalnızca 'npm run eval' komutu ile terminalden canlı değerlendirme yapmak istediğinizde kullanılır.

# OpenAI veya OpenAI-uyumlu Sağlayıcı Anahtarı
OPENAI_API_KEY=sk-your-openai-api-key-here

# Kullanılacak Model Adı (Varsayılan: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# API Base URL (Örnek: https://api.openai.com/v1 veya http://localhost:11434/v1)
OPENAI_BASE_URL=https://api.openai.com/v1
